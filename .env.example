# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
# Entreprise autorisée à consulter les prospects globaux (vide = accès désactivé).
SONARA_BACKOFFICE_COMPANY_ID=

# PostgreSQL / Supabase
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=replace_me
SUPABASE_POOLER_HOST=
SUPABASE_POOLER_PORT=6543
SUPABASE_USE_SESSION_POOLER=false
SUPABASE_USE_DIRECT_CONNECTION=false
PG_POOL_MAX=5
# Développement local uniquement si le réseau injecte un certificat TLS.
PG_SSL_REJECT_UNAUTHORIZED=true

# Authentification
JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
JWT_REFRESH_SECRET=replace_with_at_least_32_random_characters
# Optionnel : clé dédiée au chiffrement 2FA (sinon JWT_REFRESH_SECRET est utilisé).
TOTP_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Vapi / téléphonie
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_WEBHOOK_SECRET=replace_with_a_random_secret
TRANSFER_AGENT_NUMBER=
CAMPAIGN_MAX_CONCURRENT_CALLS=10
# Plafond partagé par toutes les campagnes (doit rester <= limite du fournisseur).
GLOBAL_MAX_CONCURRENT_CALLS=10
ALLOW_OUT_OF_HOURS_CALLS=false
CALL_RECONCILE_GRACE_MINUTES=15
LIVE_CALL_MAX_AGE_MINUTES=30
VAPI_MAX_RESPONSE_TOKENS=100
VAPI_ENDPOINTING_MS=350
VAPI_START_SPEAKING_WAIT_SECONDS=0.1
VAPI_PUNCTUATION_SECONDS=0.1
VAPI_NO_PUNCTUATION_SECONDS=0.9
VAPI_NUMBER_SECONDS=0.35
VAPI_STOP_SPEAKING_VOICE_SECONDS=0.15
VAPI_STOP_SPEAKING_BACKOFF_SECONDS=0.5

# ElevenLabs / Deepgram
ELEVENLABS_PROVIDER=11labs
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_VOICE_AWA=
ELEVENLABS_VOICE_KOFFI=
# Anciens noms encore acceptés pour compatibilité.
ELEVENLABS_VOICE_INGRID=
ELEVENLABS_VOICE_LOIC=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=multi

# Modèle de langage
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENROUTER_MODEL=openai/gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Rate limiting, tâches internes et e-mails
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
INTERNAL_JOB_KEY=replace_with_a_random_secret
CRON_SECRET=replace_with_a_random_secret
RESEND_API_KEY=
REPORT_EMAIL_FROM=Sonara <reports@example.com>

# Seed local destructif — laisser désactivé par défaut.
ALLOW_DESTRUCTIVE_SEED=false
DEMO_SEED_PASSWORD=
